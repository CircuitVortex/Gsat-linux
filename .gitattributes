# Normalize line endings in the repository itself, not in the working copy.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.ini  text eol=lf
*.mk   text eol=lf
*.txt  text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.bin  binary
*.dmp  binary
